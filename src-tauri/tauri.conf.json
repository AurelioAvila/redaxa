{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Redaxa",
  "version": "0.3.0",
  "identifier": "com.aurelioavila.redaxa",
  "build": {
    "frontendDist": "../desktop-dist",
    "devUrl": "http://127.0.0.1:4173",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Redaxa",
        "width": 960,
        "height": 680,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://promptshield-beta.vercel.app"
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "tooltip": "Redaxa — local prompt protection"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBNDA3NzYyMzQ4NjMyRDIKUldUU01vWTBZbmRBR3Z1bEN3N2xYK0VIeUwzaEo4UU1lS2ZMR25xMlFHZ2FuUEZvZENzcXdldDYK",
      "endpoints": [
        "https://github.com/AurelioAvila/redaxa/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Aurelio Avila",
    "copyright": "Copyright © 2026 Aurelio Avila. All rights reserved.",
    "shortDescription": "Catches personal data and secrets in your prompt before it reaches an AI tool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  }
}
