{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PromptShield",
  "version": "0.1.1",
  "identifier": "com.aurelioavila.promptshield",
  "build": {
    "frontendDist": "../desktop-dist",
    "devUrl": "http://127.0.0.1:4173",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "PromptShield",
        "width": 1200,
        "height": 820,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "tooltip": "PromptShield — local prompt protection"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
