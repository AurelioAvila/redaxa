# Never put prompt content or API keys here.
PORT=4173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PERSONAL_MONTHLY=
STRIPE_PRICE_PERSONAL_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
APP_URL=https://promptshield-beta.vercel.app

# Three-day free trial with the customer's choice (Start trial / Subscribe now).
# Off unless "true"; apply supabase/migrations/20261014_trial_claims.sql first.
# Off = the behaviour before: clients without the choice get the 7-day trial.
TRIAL_ENABLED=false
# Vercel Cron sends it as "Authorization: Bearer ..." to the trial reminder
# sweep (vercel.json crons). Without it the sweep refuses to run.
CRON_SECRET=

# Transactional email (Resend). Without RESEND_API_KEY nothing is sent at all,
# which is the right behaviour locally. But with the key set and
# REDAXA_MAIL_FROM missing, `send` now refuses rather than falling back to a
# guessed address: the address must be on a domain verified on the Resend
# account, or the provider rejects every message and the only trace is a log
# line no one reads.
RESEND_API_KEY=
REDAXA_MAIL_FROM=Redaxa <noreply@your-verified-domain>
# Free fallbacks, tried only when the previous provider did not take a message
# (quota, refusal, unverified domain, 5xx, timeout); skipped while empty.
# EMAIL_PROVIDERS=resend,smtp2go,mailjet
SMTP2GO_API_KEY=
MAILJET_API_KEY=
MAILJET_API_SECRET=
# EMAIL_SINK=1 sends nothing and writes the HTML to EMAIL_SINK_DIR (previews).
# Where the owner's heads-up about a new sale goes.
OWNER_INBOX=
