{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": ["scanner.ts", "dashboard.ts", "desktop.ts", "pwa.ts", "auth.ts", "landing.ts", "server.ts", "scanner.test.ts", "api/**/*.ts"],
  "exclude": ["api/**/*.test.ts"]
}
